# Anthropic API key (required). Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Bearer token used to secure /sse and /messages.
# If left unset, auth is skipped (fine for local dev, NOT for production).
AUTH_TOKEN=choose-a-long-random-secret

# Port the server listens on (Render injects its own PORT; defaults to 3000).
PORT=3000
